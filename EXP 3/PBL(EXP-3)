#include <iostream> 
using namespace std; 
void read(int arr[], int len) { 
cout << "Enter array elements: "; 
for (int i = 0; i < len; i++) { 
cin >> arr[i]; 
} 
} 
void display(int arr[], int len) { 
for (int i = 0; i < len; i++) { 
cout << arr[i] << " "; 
} 
cout << endl; 
} 
void swap(int &a, int &b) { 
int temp = a; 
a = b; 
b = temp; 
} 
void sort(int arr[], int len) { 
for (int i = 0; i < len - 1; i++) { 
for (int j = 0; j < len - i - 1; j++) { 
if (arr[j] > arr[j + 1]) { 
swap(arr[j], arr[j + 1]); 
} 
} 
} 
}
int main() { 
int len; 
cout << "Define the length of the array: "; 
cin >> len; 
int arr[len]; 
read(arr, len); 
cout << "The given array is: "; 
display(arr, len); 
sort(arr, len); 
cout << "The sorted array is: "; 
display(arr, len); 
return 0; 
} 
