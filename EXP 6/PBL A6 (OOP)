#include <iostream>
using namespace std;

class Complex
{
    int real, imag;

public:
    // Function to accept complex number
    void getData()
    {
        cout << "Enter real part: ";
        cin >> real;

        cout << "Enter imaginary part: ";
        cin >> imag;
    }
    Complex operator-()
    {
        Complex temp;
        temp.real = -real;
        temp.imag = -imag;
        return temp;
    }
    void display()
    {
        cout << real << " + " << imag << "i" << endl;
    }
};
int main()
{
    Complex c1, c2;
    cout << "Enter a complex number:" << endl;
    c1.getData();
    c2 = -c1;
    cout << "Negative of the complex number: ";
    c2.display();
    return 0;
