
#include <iostream>
#include <fstream>
using namespace std;

int main() {
    string line;

    ifstream fin("input.txt");
    ofstream fout("output.txt");

    if (!fin.is_open() || !fout.is_open()) {
        cout << "Error opening file!";
        return 1;
    }

    while (getline(fin, line)) {
        fout << line << endl;
    }

    cout << "Contents copied successfully.";

    fin.close();
    fout.close();

    return 0;
}
