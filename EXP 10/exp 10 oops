
#include <iostream>
using namespace std;

int main() {
    float balance = 5000, amount;

    cout << "Enter withdrawal amount: ";
    cin >> amount;

    try {
        if (amount > balance)
            throw "Insufficient bank balance!";

        balance -= amount;
        cout << "Withdrawal successful\n";
        cout << "Remaining balance: " << balance;
    }
    catch (const char* msg) {
        cout << "Exception: " << msg;
    }

    return 0;
}
